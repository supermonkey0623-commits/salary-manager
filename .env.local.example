# Google OAuth 2.0
# Google Cloud Console > APIs & Services > Credentials で取得
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# アクセスを許可するGoogleアカウントのメールアドレス（自分のGmailアドレス）
ALLOWED_EMAIL=your@gmail.com

# NextAuth.js シークレット（openssl rand -base64 32 で生成）
NEXTAUTH_SECRET=your-nextauth-secret
NEXTAUTH_URL=http://localhost:3000

# Supabase
# https://supabase.com のプロジェクト設定から取得
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Anthropic Claude API
# https://console.anthropic.com で取得
ANTHROPIC_API_KEY=sk-ant-...
